# Copy to .env and fill in. This file stays inside the harness folder.
# The Ollama address, models and context are in config.toml (see `nfh config`).
# To override just the address for one shell or session:
# NFH_OLLAMA_HOST=http://127.0.0.1:11435
# Scout: OpenCode's built-in web search (free key, no card)
TINYFISH_API_KEY=
# Scout: scholarly metadata (free key from openalex.org/settings/api)
OPENALEX_API_KEY=
# Scout: open-access full text lookup (any real address you read)
UNPAYWALL_EMAIL=
