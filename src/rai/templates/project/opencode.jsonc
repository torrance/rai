// Generated by rai from config.toml (and this project's rai.toml).
// Change the settings there, then run `rai sync`; edits made here are kept
// (rai writes opencode.jsonc.rai-new beside the file instead of overwriting).
{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{OC_MODEL_RESEARCH_BASE}}",
  "default_agent": "assistant",
  "instructions": [".rai/brief.md"],
  "websearch": { "provider": "tinyfish" },
  "providers": {{OC_PROVIDERS_JSON}},
  "mcp": {
    "servers": {
      "rai": {
        "type": "local",
        "command": {{RAI_COMMAND_JSON}},
        "codemode": false
      },
      "zotero": {
        "type": "local",
        "command": ["uvx", "--from", "zotero-mcp-server==0.17.3", "zotero-mcp"],
        "environment": { "ZOTERO_LOCAL": "true" },
        "codemode": false
      },
      "papers": {
        "type": "local",
        "command": {{PAPERS_COMMAND_JSON}},
        "codemode": false
      }
    }
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "rai_*", "resource": "*", "effect": "deny" },
    { "action": "zotero_*", "resource": "*", "effect": "deny" },
    { "action": "papers_*", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "build": { "disabled": true },
    "plan": { "disabled": true }
  }
}
