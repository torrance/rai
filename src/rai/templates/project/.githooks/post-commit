#!/bin/sh
# After a commit that touches drafts/, refresh chapter notes, claims and the
# briefing in the background. Output goes to .rai/logs/hook.log.
# Generated by rai from its settings; run `rai sync` after changing them.
RAI='{{RAI_COMMAND_SH}}'
if git diff-tree --root --no-commit-id --name-only -r HEAD | grep -q '^drafts/'; then
  mkdir -p .rai/logs
  nohup sh -c "$RAI --project . manuscript && $RAI --project . brief" >> .rai/logs/hook.log 2>&1 &
fi
