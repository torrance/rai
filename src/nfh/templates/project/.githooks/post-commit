#!/bin/sh
# After a commit that touches drafts/, refresh chapter notes, claims and the
# briefing in the background. Output goes to .nfh/logs/hook.log.
# Generated by nfh from its settings; run `nfh sync` after changing them.
NFH='{{NFH_COMMAND_SH}}'
if git diff-tree --root --no-commit-id --name-only -r HEAD | grep -q '^drafts/'; then
  mkdir -p .nfh/logs
  nohup sh -c "$NFH --project . manuscript && $NFH --project . brief" >> .nfh/logs/hook.log 2>&1 &
fi
