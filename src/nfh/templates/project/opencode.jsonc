// Generated by nfh from config.toml (and this project's nfh.toml).
// Change the settings there, then run `nfh sync`; edits made here are kept
// (nfh writes opencode.jsonc.nfh-new beside the file instead of overwriting).
{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{OC_MODEL}}",
  "default_agent": "assistant",
  "instructions": [".nfh/brief.md"],
  "websearch": { "provider": "tinyfish" },
  "providers": {
    "{{OC_PROVIDER}}": {
      "package": "{{OC_PACKAGE}}",
      "settings": { "baseURL": "{{OLLAMA_V1_URL}}", "headerTimeout": false },
      "models": {
        "{{OC_ALIAS}}": {
          "modelID": "{{CHAT_MODEL}}",
          "variants": [
            // Check which field your Ollama version accepts on /v1.
            { "id": "{{OC_QUICK_VARIANT}}", "body": {{OC_QUICK_BODY}} }
          ]
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "nfh": {
        "type": "local",
        "command": {{NFH_COMMAND_JSON}},
        "codemode": false
      },
      "zotero": {
        "type": "local",
        "command": ["uvx", "--from", "zotero-mcp-server==0.17.3", "zotero-mcp"],
        "environment": { "ZOTERO_LOCAL": "true" },
        "codemode": false
      },
      "papers": {
        "type": "local",
        "command": {{PAPERS_COMMAND_JSON}},
        "codemode": false
      }
    }
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "nfh_*", "resource": "*", "effect": "deny" },
    { "action": "zotero_*", "resource": "*", "effect": "deny" },
    { "action": "papers_*", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "build": { "disabled": true },
    "plan": { "disabled": true }
  }
}
